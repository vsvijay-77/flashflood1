# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# Local Mongo connection used by motor.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="app"

# Comma-separated allowed origins, or "*" for local development.
CORS_ORIGINS="*"

# Public base URL of the deployed app.
APP_URL=http://localhost:3000

# Secret used to sign session JWTs. Generate a fresh one per environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes for HS256 (RFC 7518). Rotating this invalidates all sessions.
JWT_SECRET=replace-me-with-a-long-random-string
