# .vercelignore — Exclude non-runtime and heavy assets from Vercel deployment bundle

# Caches and virtual environments
.venv/
venv/
backend/venv/
backend/.venv/
backend/cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Large datasets, model weights, and checkpoints
dataset/
backend/ml/
backend/tests/
tests/
*.csv
*.pt
*.bin
*.pkl

# Logs
*.log
.logs/

# Frontend node_modules (re-installed during Vercel build if needed, not bundled in Python lambda)
frontend/node_modules/
node_modules/
