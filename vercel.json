{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,node_modules/**,dataset/**,tests/**,dist/**,backend/cache/**,backend/ml/checkpoints/**,backend/tests/**,**/__pycache__/**,**/.env,**/.env.local}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "_prebaked_version": "2_real_osm"
}