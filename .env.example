# ─────────────────────────────────────────────────────────────────────────────
# NEXGI — Environment Variable Template
# Copy to .env (backend/.env for local dev) and fill in real values.
# NEVER commit a file containing real credentials.
# On Vercel: add these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URL=
DB_NAME=

# ── App Config ────────────────────────────────────────────────────────────────
CORS_ORIGINS=
APP_URL=

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Supabase (backend — SECRET, never expose to frontend) ─────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_DB_PASSWORD=

# ── Supabase (frontend — VITE_ prefix, safe for browser bundle) ───────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── External PostgreSQL Sensor Database ───────────────────────────────────────
SENSOR_DB_URL=

# ── LLM / Qwen Chatbot API ────────────────────────────────────────────────────
LLM_API_URL=

# ── Qdrant Vector Search ──────────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# ── Weather & Terrain APIs ────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
OPENTOPO_API_KEY=

# ── Twilio SMS / Telephony ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
