# Copy to frontend/.env if needed. NEVER commit the real .env.
# No frontend env vars are required for local dev — API calls use relative /api paths
# through the Vite proxy.
#
# For Vercel deployment, set these in the Vercel dashboard → Project → Settings → Environment Variables.

# ─── Supabase (optional) ──────────────────────────────────────────────────────
# The app works fully without Supabase. These are only needed for OAuth SSO features.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
